    "serialize-javascript": "7.0.5",
    "undici": "7.29.0",
    "ws": "8.21.1",
    "brace-expansion@^1.1.7": "1.1.18",
    "brace-expansion@^2.0.0": "2.1.4",
    "brace-expansion@^5.0.0": "5.0.9"
  }
