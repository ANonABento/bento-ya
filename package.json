{
  "name": "kaitencode",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "profile": "VITE_REACT_SCAN=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "precommit": "lint-staged",
    "sync:updater-endpoint": "node scripts/sync-updater-endpoint.js",
    "tauri": "tauri",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test:ipc": "node scripts/check-ipc-registration.js",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:webdriver": "pnpm exec wdio run wdio.conf.mjs",
    "build:webdriver": "cd src-tauri && cargo build --features webdriver"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.2.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "webdriverio": "^9.27.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv"
      ]
    },
    "overrides": {
      "@babel/core": "7.29.7",
      "basic-ftp": "5.3.1",
      "deepmerge-ts": "8.0.2",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.5",
      "fast-xml-builder": "1.1.7",
      "fast-xml-parser": "5.8.0",
      "flatted": "3.4.2",
      "ip-address": "10.5.0",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "picomatch": "4.0.4",
      "postcss": "8.5.24",
      "serialize-javascript": "7.0.5",
      "undici": "7.29.0",
      "vite": "6.4.3",
      "ws": "8.21.1",
      "brace-expansion@^1.1.7": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9"
    }
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "basic-ftp": "5.3.1",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.1",
